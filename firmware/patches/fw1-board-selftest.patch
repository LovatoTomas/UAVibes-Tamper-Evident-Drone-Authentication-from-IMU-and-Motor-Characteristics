@@ -42,4 +42,23 @@ bool sensorsBmi088Bmp3xxReadBaro(baro_t *baro);
 void sensorsBmi088Bmp3xxSetAccMode(accModes accMode);
 void sensorsBmi088Bmp3xxDataAvailableCallback(void);
 
+/* UAVibe (2026-10): board fingerprint measured at every boot (accelerometer
+ * self-test, gyroscope bias, accelerometer scale). The on-board key app (FW2)
+ * reads it through this function. The same values are also exposed as the
+ * read-only param group "uavibe" for the research tools, unless the firmware is
+ * built with UV_HIDE_BOARD_PARAMS: params can be read by anyone in radio range,
+ * so a drone in service must not expose them. */
+typedef struct {
+  uint8_t stDone;          // self-test attempts used
+  int8_t stResult;         // 0 = valid, -1 = failed, -2 = not run
+  int16_t stPos[3];        // raw self-test readings, positive direction (LSB, 24 g)
+  int16_t stNeg[3];        // raw self-test readings, negative direction
+  float gBias[3];          // gyroscope bias found at boot
+  uint8_t gBiasOk;
+  float accScale;          // accelerometer scale found at boot
+  uint8_t accScaleOk;
+} uvBoardFingerprint_t;
+
+void uvBoardFingerprintGet(uvBoardFingerprint_t *out);
+
 #endif // __SENSORS_BMI088_BMP3XX_H__

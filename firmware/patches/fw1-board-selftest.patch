diff --git a/src/hal/interface/sensors_bmi088_bmp3xx.h b/src/hal/interface/sensors_bmi088_bmp3xx.h
index ec23ee6d..d3660a4f 100644
--- a/src/hal/interface/sensors_bmi088_bmp3xx.h
